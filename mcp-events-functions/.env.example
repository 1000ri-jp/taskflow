# Copy to the Firebase project's local env file and fill from approved deployment configuration.
# Keep disabled until the existing single-project scope and runtime account are verified.
SLOWTH_MCP_WORKER_ENABLED=false
SLOWTH_MCP_EVENTS_PROJECT_ID=<APPROVED_SLOWTH_PROJECT_ID>
SLOWTH_MCP_OAUTH_ALLOWED_UID=<APPROVED_FIREBASE_AUTH_UID>

# SLOWTH_MCP_OAUTH_STORAGE_KEY is a Firebase Secret Manager secret.
# Do not put its value, OAuth tokens, callback URLs or signing keys in this file.
