# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
# Isolated development and verification builds (NEXT_DEV_DIST_DIR).
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
firestore-debug.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dependency-health-report.md
dependency-health-summary.json

# env files
.env
.env.local
.env.*.local
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Vercel env files
.env.vercel
.env.vercel.*
.env.check

# Local build logs, release evidence, source snapshots and private backups.
# Keep reusable code, tests and documentation outside this directory.
/tmp/

# Internal recordings are supplied privately before release, never via public Git.
/src/assets/help-videos/
