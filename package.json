{
  "name": "taskflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "NEXT_PUBLIC_E2E_MOCK_AUTH=true next dev -p 3002",
    "dev:secretary": "NEXT_PUBLIC_E2E_MOCK_AUTH=true next dev --hostname 127.0.0.1 -p 3010",
    "dev:real": "NEXT_PUBLIC_E2E_MOCK_AUTH=false NEXT_PUBLIC_ENABLE_TEST_AUTH=false NEXT_DEV_DIST_DIR=.next-real next dev --hostname 127.0.0.1 -p 3003",
    "desktop:mac": "./scripts/run-desktop-mini-mac.sh",
    "build": "node ./scripts/run-next-build.mjs",
    "start": "next start",
    "audit": "npm audit --omit=optional --audit-level=high",
    "deps:report": "node ./scripts/dependency-health-report.mjs",
    "seed:demo": "node --env-file-if-exists=.env.local ./scripts/seed-demo.mjs",
    "lint": "eslint src e2e scripts playwright*.config.ts eslint.config.mjs next.config.ts && npm run ui:check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:rules": "npx --yes firebase-tools@15.30.2 emulators:exec --project demo-taskflow-release --only firestore --config firebase.emulators.json 'node scripts/firestore-rules.test.mjs'",
    "test:member-migration": "node --test scripts/project-member-migration.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "node ./scripts/run-playwright-smoke.mjs",
    "test:e2e:secretary": "playwright test --config playwright.secretary.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "ui:refresh": "node scripts/ui-guide.mjs --refresh",
    "release:prepare": "node scripts/prepare-release.mjs",
    "ui:check": "node scripts/ui-guide.mjs",
    "ui:compare": "node scripts/ui-guide.mjs --compare-worktree",
    "ui:test": "node --test scripts/ui-guide.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@holiday-jp/holiday_jp": "2.5.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/lodash": "^4.17.24",
    "ai": "^6.0.116",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "html2canvas-pro": "2.4.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.6",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "postcss": "8.5.28",
    "websocket-driver": "0.7.5"
  }
}
