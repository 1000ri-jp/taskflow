# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project credentials

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Local mode: keep both false for real Firebase data.
NEXT_PUBLIC_E2E_MOCK_AUTH=false
NEXT_PUBLIC_ENABLE_TEST_AUTH=false

# Firebase Admin SDK (for server-side AI key management)
# Option 1: Service account key as JSON string
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# Option 2: Use GOOGLE_APPLICATION_CREDENTIALS environment variable
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google Workspace: server-only OAuth. Register this callback in the same Google OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3003/api/google/callback
# Generate a random 32-byte hex value; keep stable to decrypt saved refresh tokens.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Use a separate namespace for local/production. Never reuse across environments.
GOOGLE_WORKSPACE_NAMESPACE=local

# Product background runner. Keep disabled until the separate Cloud Run Job / Scheduler is verified.
TASK_AUTOMATION_JOB_SECRET=
TASK_AUTOMATION_SCHEDULED=false
# Used only by scripts/run-task-automation-job.mjs, not by the browser.
TASK_AUTOMATION_URL=
